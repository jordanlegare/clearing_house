# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Public CRA/Open Canada ingestion
T3010_YEAR=2024
T3010_DATA_DIR=data/t3010/2024
ENABLE_T3010_SYNC=0

# Workflow writes stay OFF until persistence + identity are configured.
ENABLE_WORKFLOW_WRITES=0

# Production persistence
DATABASE_URL=

# OAuth/OIDC for authenticated workflow actors. Provider must support refresh/offline access for ChatGPT continuity.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# Secrets used only once private workflow data is enabled. Use secret-manager values in production.
ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

# Providers: notifications = disabled|console|twilio|email ; payments = disabled|manual
NOTIFICATION_PROVIDER=disabled
PAYMENT_PROVIDER=disabled

# Safety/compliance controls
CRA_STATUS_MAX_AGE_HOURS=24
REQUIRE_SEPARATION_OF_DUTIES=1
RETENTION_DAYS=2555
