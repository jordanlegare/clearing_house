# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Public CRA/Open Canada ingestion
T3010_YEAR=2024
T3010_DATA_DIR=data/t3010/2024
ENABLE_T3010_SYNC=0

# Authenticated grant workflow. Keep OFF until readiness passes.
ENABLE_WORKFLOW_WRITES=0
DATABASE_URL=

# OAuth/OIDC. ChatGPT deployments should request offline_access/refresh-token support.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# Private workflow protection. Store these in a secret manager in production.
ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

# Notifications: disabled|console|twilio
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_BATCH_SIZE=25
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments remain external/manual. The app records authorization/reference only.
PAYMENT_PROVIDER=disabled

# Safety/compliance controls
CRA_STATUS_MAX_AGE_HOURS=24
REQUIRE_SEPARATION_OF_DUTIES=1
RETENTION_DAYS=2555
