# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Public CRA/Open Canada ingestion
T3010_YEAR=2024
T3010_DATA_DIR=data/t3010/2024
ENABLE_T3010_SYNC=1
T3010_SYNC_INTERVAL_HOURS=24
T3010_AUTO_RELOAD_SECONDS=300

# Autonomous operations worker
AUTOMATION_ENABLED=1
AUTOMATION_POLL_SECONDS=10
AUTOMATION_LEASE_SECONDS=300

# Foundation allocation policies. Keep OFF until authenticated workflow readiness passes.
AUTOMATED_PORTFOLIOS_ENABLED=0
ALLOCATION_POLICY_POLL_SECONDS=300
ALLOCATION_POLICY_BATCH_SIZE=10

# Authenticated grant workflow. Keep OFF until readiness passes.
ENABLE_WORKFLOW_WRITES=0
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/clearing_house

# No-account recipient offer portal. In production use a public HTTPS URL routed to the portal service.
RECIPIENT_PORTAL_ENABLED=0
RECIPIENT_PORTAL_BASE_URL=http://localhost:3001
RECIPIENT_PORTAL_PORT=3001
OFFER_TOKEN_TTL_HOURS=168

# Public website fallback when T3010 has no usable recipient phone.
# The crawler is public-network-only, same-site, robots-aware, bounded, and still requires channel verification.
WEBSITE_CONTACT_ENRICHMENT_ENABLED=0
WEBSITE_CONTACT_TIMEOUT_MS=5000
WEBSITE_CONTACT_MAX_PAGES=4
WEBSITE_CONTACT_MAX_BYTES=524288

# OAuth/OIDC. ChatGPT deployments should request offline_access/refresh-token support.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# Private workflow protection. Store these in a secret manager in production.
ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

# Notifications: disabled|console|twilio
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_POLL_SECONDS=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments remain external/manual. The app records authorization/reference only.
PAYMENT_PROVIDER=disabled

# Safety/compliance controls
CRA_STATUS_MAX_AGE_HOURS=24
REQUIRE_SEPARATION_OF_DUTIES=1
RETENTION_DAYS=2555
