NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# CRA T3010 public data
T3010_YEAR=2024
T3010_DATA_DIR=data/t3010/2024
ENABLE_T3010_SYNC=0

# Authenticated workflow runtime: disabled by default.
ENABLE_WORKFLOW_WRITES=0
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/clearing_house

# OIDC used when workflow writes or remote sync are enabled.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Development-only HS256 auth. Never enable in production.
ALLOW_DEV_AUTH=0
DEV_AUTH_SECRET=

# Private profile encryption and tamper-evident audit chain.
ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

# Notifications: disabled | console | twilio | email
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Payments: disabled | manual. Baseline app never initiates a bank transfer.
PAYMENT_PROVIDER=disabled

CRA_STATUS_MAX_AGE_HOURS=24
REQUIRE_SEPARATION_OF_DUTIES=1
RETENTION_DAYS=2555
GRANT_TERMS_VERSION=2026-08
